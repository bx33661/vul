<div id="mst_state_password" class="mst_state"></div>

<div class="setting_main_container_list">
	<div class="setting_main_container">
		<div class="setting_main_left">
			[[PASSWORD_TITLE]]
		</div>
		<div class="setting_main_right">
			<form id='mstweb_page_password_form' name='mstweb_page_password_form'>
				<table>
				<tr>
					<td class="message">[[PASSWORD_NEW_PASSWORD]]</td>
					<td><input type="password" name='password_1' id="mstweb_page_password_txt_pass1" onkeyup="mstweb_page_password_view_update_btn()" /></td>
					<td></td>
				</tr>
				<tr>
					<td class="message">[[PASSWORD_RETYPE]]</td>
					<td><input type="password" name='password_2' id="mstweb_page_password_txt_pass2" onkeyup="mstweb_page_password_view_update_btn()" /></td>
					<td><span id="mstweb_page_password_warn_pass">[[PASSWORD_DIFFERENT_PASSWORD]]</span></td>
				</tr>
				</table>
			</form>
		</div>
		<div class="setting_main_foot"></div>
	</div>
</div>

<hr class="setting" />

<div class="mst_setting_btn_area">
	<input type="button" value="[[COMMON_APPLY]]" id="mstweb_page_password_btn_apply" onclick='mstweb_page_password_change_password()' />
	<input type="button" value="[[COMMON_CLEAR]]" id="mstweb_page_password_btn_clear" onclick='mstweb_page_password_on_clear()' />
</div>
